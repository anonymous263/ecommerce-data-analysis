function Last_Data_Date =
		(_measure: EXPR) =>
				CALCULATE(
					MAX(dim_date[date_day]),
					FILTER(
						ALLSELECTED(dim_date[date_day]),
						NOT ISBLANK(CALCULATE(_measure))
					)
				)
	lineageTag: c273b755-a6ab-40f0-90ba-bcd389b22834

function MoM_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR CM1 = DATE(YEAR(MaxD), MONTH(MaxD), 1)
				VAR CM2 = EOMONTH(
					MaxD,
					0
				)
				VAR PM1 = EOMONTH(
					MaxD,
					-2
				) + 1
				VAR PM2 = EOMONTH(
					MaxD,
					-1
				)
				VAR CM = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= CM1 && dim_date[date_day] <= CM2
					)
				)
				VAR PM = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= PM1 && dim_date[date_day] <= PM2
					)
				)
				RETURN
					DIVIDE(
						CM - PM,
						PM,
						BLANK()
					)
	lineageTag: fee5cc78-9847-4230-836d-dbd8c577f04b

function YoY_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR CY1 = DATE(YEAR(MaxD), MONTH(MaxD), 1)
				VAR CY2 = EOMONTH(
					MaxD,
					0
				)
				VAR PY1 = EDATE(
					CY1,
					-12
				)
				VAR PY2 = EOMONTH(
					PY1,
					0
				)
				VAR CY = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= CY1 && dim_date[date_day] <= CY2
					)
				)
				VAR PY = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= PY1 && dim_date[date_day] <= PY2
					)
				)
				RETURN
					DIVIDE(
						CY - PY,
						PY,
						BLANK()
					)
	lineageTag: 6e5a6556-f32e-4c71-b8bd-856da0f34307

function MoM_Icon =
		(_measure: EXPR) =>
				VAR d = MOM_PERC(_measure)
				RETURN
					IF(
						ISBLANK(d),
						"–",
						IF(
							d >= 0,
							UNICHAR(9650),
							UNICHAR(9660)
						) & " " & FORMAT(
							ABS(d),
							"0.0%"
						) & " MoM"
					)
	lineageTag: 9cbbb7aa-9897-456e-a99c-458367e95eec

