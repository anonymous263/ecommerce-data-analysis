function QoQ_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR QStart = DATE(YEAR(MaxD), INT((MONTH(MaxD) - 1) / 3) * 3 + 1, 1)
				VAR PrevEnd = EDATE(
					MaxD,
					-3
				)
				VAR PQStart = EDATE(
					QStart,
					-3
				)
				VAR CQ = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= QStart && dim_date[date_day] <= MaxD
					)
				)
				VAR PQ = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= PQStart && dim_date[date_day] <= PrevEnd
					)
				)
				RETURN
					DIVIDE(
						CQ - PQ,
						PQ,
						BLANK()
					)
	lineageTag: 6668ddd5-0dbb-4302-94b3-c3674d14680e

