function YTD_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR YStart = DATE(YEAR(MaxD), 1, 1)
				VAR PrevEnd = EDATE(
					MaxD,
					-12
				)
				VAR PYStart = DATE(YEAR(MaxD) - 1, 1, 1)
				VAR CYTD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= YStart && dim_date[date_day] <= MaxD
					)
				)
				VAR PYTD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= PYStart && dim_date[date_day] <= PrevEnd
					)
				)
				RETURN
					DIVIDE(
						CYTD - PYTD,
						PYTD,
						BLANK()
					)
	lineageTag: d9bf29d3-29d7-4f03-9b4e-b08f4be93748

