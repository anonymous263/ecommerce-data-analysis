function PoP_Perc =
		(_measure: EXPR) =>
				VAR _StartDate = MIN(dim_date[date_day])
				VAR _EndDate = MAX(dim_date[date_day])
				VAR _PeriodLen = DATEDIFF(
					_StartDate,
					_EndDate,
					DAY
				) + 1
				VAR _PrevStart = _StartDate - _PeriodLen
				VAR _PrevEnd = _StartDate - 1
				VAR _CurrVal = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= _StartDate && dim_date[date_day] <= _EndDate
					)
				)
				VAR _PrevVal = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= _PrevStart && dim_date[date_day] <= _PrevEnd
					)
				)
				RETURN
					DIVIDE(
						_CurrVal - _PrevVal,
						_PrevVal,
						BLANK()
					)
	lineageTag: 7eabe4d7-9688-4772-a8b3-fdbadb4a4ac0

