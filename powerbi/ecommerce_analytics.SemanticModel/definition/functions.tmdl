function Delta_Color =
		(_value: EXPR) =>
				VAR IsText = NOT ISNONTEXT(_value)
				VAR PctPos = IF(
					IsText,
					FIND(
						"%",
						_value,
						1,
						0
					),
					0
				)
				VAR NumText = IF(
					IsText && PctPos > 0,
					TRIM(SUBSTITUTE(
						SUBSTITUTE(
							LEFT(
								_value,
								PctPos - 1
							),
							UNICHAR(9650),
							""
						),
						UNICHAR(9660),
						""
					))
				)
				VAR HasDown = IsText && CONTAINSSTRING(
					_value,
					UNICHAR(9660)
				)
				VAR NumRaw = IF(
					ISBLANK(_value),
					BLANK(),
					IF(
						IsText,
						IF(
							PctPos > 0,
							DIVIDE(
								VALUE(NumText),
								100
							),
							BLANK()
						),
						_value
					)
				)
				VAR NumSigned = IF(
					IsText,
					IF(
						HasDown,
						-ABS(NumRaw),
						ABS(NumRaw)
					),
					NumRaw
				)
				RETURN
					SWITCH(
						TRUE(),
						ISBLANK(NumSigned), "#9AA3AF",
						NumSigned > 0, "#2E8B4F",
						NumSigned < 0, "#E5484D",
						"#6B7280"
					)
	lineageTag: 4a6be2da-02d9-4aae-84c3-ba2b22212691

function Delta_Color_Inverse =
		(_value: EXPR) =>
				VAR IsText = NOT ISNONTEXT(_value)
				VAR PctPos = IF(
					IsText,
					FIND(
						"%",
						_value,
						1,
						0
					),
					0
				)
				VAR NumText = IF(
					IsText && PctPos > 0,
					TRIM(SUBSTITUTE(
						SUBSTITUTE(
							LEFT(
								_value,
								PctPos - 1
							),
							UNICHAR(9650),
							""
						),
						UNICHAR(9660),
						""
					))
				)
				VAR HasDown = IsText && CONTAINSSTRING(
					_value,
					UNICHAR(9660)
				)
				VAR NumRaw = IF(
					ISBLANK(_value),
					BLANK(),
					IF(
						IsText,
						IF(
							PctPos > 0,
							DIVIDE(
								VALUE(NumText),
								100
							),
							BLANK()
						),
						_value
					)
				)
				VAR NumSigned = IF(
					IsText,
					IF(
						HasDown,
						-ABS(NumRaw),
						ABS(NumRaw)
					),
					NumRaw
				)
				RETURN
					SWITCH(
						TRUE(),
						ISBLANK(NumSigned), "#9AA3AF",
						NumSigned > 0, "#E5484D",
						NumSigned < 0, "#2E8B4F",
						"#6B7280"
					)
	lineageTag: 47579ceb-a2b4-4533-b86f-ce9672fcc7c0

function MoM_Color =
		(_measure: EXPR) =>
				DELTA_COLOR(MOM_PERC(_measure))
	lineageTag: 6c0e6d2d-2b7b-4889-9692-f36a82ab4e6a

function YoY_Color =
		(_measure: EXPR) =>
				DELTA_COLOR(YOY_PERC(_measure))
		
				// ============================================================
				// VÍ DỤ MEASURE ÁP DỤNG (tạo trong _Measures sau khi có UDF):
				//
				//   Revenue MoM %        = MoM_Perc ( [Revenue] )                        -- 0.0%
				//   Revenue MoM Delta    = MoM_Icon ( [Revenue] )                        -- text label card
				//   Revenue MoM Color    = MoM_Color ( [Revenue] )                       -- fx font color
				//   Revenue YoY Delta    = YoY_Icon ( [Revenue] )
				//   Revenue YoY Color    = YoY_Color ( [Revenue] )
				//   Revenue QoQ Delta    = QoQ_Icon ( [Revenue] )
				//   Revenue QoQ Color    = Delta_Color ( QoQ_Perc ( [Revenue] ) )
				//   Revenue WoW Delta    = WoW_Icon ( [Revenue] )
				//   Revenue PoP Delta    = PoP_Icon ( [Revenue] )                        -- cần date slicer
				//
				//   -- Metric "tăng là XẤU" -> dùng Inverse:
				//   Total Cost MoM Delta  = MoM_Icon ( [Total Cost] )
				//   Total Cost MoM Color  = Delta_Color_Inverse ( MoM_Perc ( [Total Cost] ) )
				//   Failed Rate YoY Color = Delta_Color_Inverse ( YoY_Perc ( [Failed Rate] ) )
				// ============================================================
	lineageTag: a63b01a8-61e6-44ab-bf23-a201ba3f56fe

