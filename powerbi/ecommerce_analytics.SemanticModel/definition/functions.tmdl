function WoW_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR CurrWeek = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= MaxD - 6 && dim_date[date_day] <= MaxD
					)
				)
				VAR PrevWeek = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= MaxD - 13 && dim_date[date_day] <= MaxD - 7
					)
				)
				RETURN
					DIVIDE(
						CurrWeek - PrevWeek,
						PrevWeek,
						BLANK()
					)
	lineageTag: 610a6af3-65be-460d-8197-5b95caddfc92

