function MoM_MTD_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR CM1 = DATE(YEAR(MaxD), MONTH(MaxD), 1)
				VAR PrevEnd = EDATE(
					MaxD,
					-1
				)
				VAR PM1 = DATE(YEAR(PrevEnd), MONTH(PrevEnd), 1)
				VAR CM_MTD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= CM1 && dim_date[date_day] <= MaxD
					)
				)
				VAR PM_MTD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] >= PM1 && dim_date[date_day] <= PrevEnd
					)
				)
				RETURN
					DIVIDE(
						CM_MTD - PM_MTD,
						PM_MTD,
						BLANK()
					)
	lineageTag: 6dc9789d-787a-45ef-84b1-36d48e1bdd99

