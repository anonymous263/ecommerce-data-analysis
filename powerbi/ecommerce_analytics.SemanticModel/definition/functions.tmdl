function DoD_Perc =
		(_measure: EXPR) =>
				VAR MaxD = LAST_DATA_DATE(_measure)
				VAR CD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] = MaxD
					)
				)
				VAR PD = CALCULATE(
					_measure,
					FILTER(
						ALL(dim_date[date_day]),
						dim_date[date_day] = MaxD - 1
					)
				)
				RETURN
					DIVIDE(
						CD - PD,
						PD,
						BLANK()
					)
	lineageTag: 0693f916-da82-44c0-9f8b-dd11ecb1405d

