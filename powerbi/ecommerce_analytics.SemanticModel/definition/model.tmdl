model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_country","dim_customer_anonymized","dim_date","dim_payment_method","dim_product","dim_site","fact_order","fact_order_item","fact_refund","mart_customer_summary","mart_order_profit","mart_product_profit","_Measures"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling","DaxQueryView_Desktop"]

ref table dim_country
ref table dim_customer_anonymized
ref table dim_date
ref table dim_payment_method
ref table dim_product
ref table dim_site
ref table fact_order
ref table fact_order_item
ref table fact_refund
ref table mart_customer_summary
ref table mart_order_profit
ref table mart_product_profit
ref table _Measures

ref cultureInfo en-US

