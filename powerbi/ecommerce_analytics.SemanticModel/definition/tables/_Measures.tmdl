			    TRUE (),
			    [Profit Margin] >= 0.56, "#2E8B4F",   -- green
			    [Profit Margin] >= 0.53, "#E0A82E",   -- sand
			    "#E5484D"                              -- red
			)
		displayFolder: Markets
		lineageTag: 3f43beb1-00c6-4731-b7fa-fabc7897f15e

