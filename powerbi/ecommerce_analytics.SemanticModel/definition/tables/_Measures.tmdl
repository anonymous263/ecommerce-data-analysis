table _Measures
	lineageTag: a0426c5b-05c6-4ed5-a7a1-402d3e13566e

	/// Gross product revenue ($119,261.71). Lives once at item grain (rule #1) - never read revenue from fact_order. Now slices by country/customer/payment too (conformed FKs pushed to fact_order_item, redesign 2026-07-24); plain [Revenue] on a country/payment axis is correct.
	measure Revenue =
			
			CALCULATE (
			    SUM ( fact_order_item[line_revenue_usd] ),
			    fact_order_item[is_revenue_status] = TRUE ()
			)
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: f208adad-a1e1-4f3e-8f0b-3fb9e873c7b2

	/// Product-side net for SALES KPI display only ($117,669.69) = gross product revenue minus raw refunds. NOT the margin denominator - that is [Profit Base Net Revenue] (product + shipping - refund).
	measure 'Net Revenue' =
			
			[Revenue] - [Refund Amount]
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: d05ebe4f-76c5-447b-bd18-bca998a40e4b

	/// Units sold on revenue-status lines (4,309).
	measure 'Quantity Sold' =
			
			CALCULATE (
			    SUM ( fact_order_item[quantity] ),
			    fact_order_item[is_revenue_status] = TRUE ()
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: 4c370e46-fc40-4d7c-8f1f-6a711b153ab8

	/// Average order value $31.28 = gross revenue / paid orders. Now safe on country/payment axes - both numerator and denominator share the sliced population via conformed FKs (redesign 2026-07-24).
	measure AOV =
			
			DIVIDE ( [Revenue], [Paid Orders] )
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: 922d5711-ad57-46db-9be7-8ff165976176

	/// All-in per-order fulfilment cost ($61,256.69) - ALREADY includes the supplier fulfillment/shipping fee (rule #6). Never add a shipping cost term on top.
	measure COGS =
			
			SUM ( mart_order_profit[cogs_usd] )
		formatString: \$#,0
		displayFolder: Cost
		lineageTag: 427b11c2-40b1-4c54-8038-5ae18a51e438

	/// Processor fees ($7,131.11) from mart_order_profit - the exact column [Contribution Profit] subtracts (coalesce of Woo fee + CSV fallback). Reading fact_order gives $7,069.77 and breaks reconciliation.
	measure 'Payment Fee' =
			
			SUM ( mart_order_profit[payment_fee_usd] )
		formatString: \$#,0
		displayFolder: Cost
		lineageTag: 886c4486-4be6-4aec-8ab7-9e2dfff7854c

	/// Design fee ($2,556.39), one of the three cost components of contribution profit.
	measure 'Design Fee' =
			
			SUM ( mart_order_profit[design_fee_usd] )
		formatString: \$#,0
		displayFolder: Cost
		lineageTag: a0e84259-1441-459a-87d7-39f60bb9f891

	/// The margin/cost-ratio denominator ($157,614.83) = product revenue + customer shipping - capped refund. Read straight from mart_order_profit so it reconciles. Not for display KPIs.
	measure 'Profit Base Net Revenue' =
			
			SUM ( mart_order_profit[net_revenue_usd] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: efe3aa94-b22d-4c98-8f5a-dfbc5f0ac57a

	/// Contribution profit $86,670.64 = net_revenue - cogs - design_fee - payment_fee, pre-computed in mart_order_profit. Slices by date/site/country/customer/payment directly (mart_order_profit now carries those FKs). For BY-PRODUCT use [Product Profit] (line grain) - order grain has no product FK.
	measure 'Contribution Profit' =
			
			SUM ( mart_order_profit[contribution_profit_usd] )
		formatString: \$#,0
		displayFolder: Profit
		lineageTag: 2e562f6c-75ce-4958-bf02-8d69fd3d3480

	/// 55.0% = Contribution Profit / Profit Base Net Revenue (shipping-inclusive base). Using product-only [Net Revenue] as denominator is WRONG (gives 73.7% mixed-base nonsense).
	measure 'Profit Margin' =
			
			DIVIDE ( [Contribution Profit], [Profit Base Net Revenue] )
		formatString: 0.0%
		displayFolder: Profit
		lineageTag: edb1415b-66b6-4ad0-8a2f-4cea0c0b10c2

	/// Raw refunded value from fact_refund ($1,592.02). NOTE: the mart P&L uses capped effective_refund_usd ($1,582.49) - this raw figure is for the sales KPI and refund health only. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Refund Amount' =
			
			SUM ( fact_refund[refund_amount_usd] )
		formatString: \$#,0
		displayFolder: Operations
		lineageTag: 418c0cb7-f9c3-4470-bb22-32e19ddb6e96

	/// 1.0% = 37 / 3,813 - refund health only; cancellations are reported separately by [Cancellation Rate]. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Refund Rate' =
			
			DIVIDE ( [Refunded Orders], [Paid Orders] )
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 45cd1a9d-7a51-49fa-80e1-2bdf3496481b

	/// 10.5% = 499 / 4,757 (funnel basis, additive with Paid/Failed rates). Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Cancellation Rate' =
			
			DIVIDE ( [Cancelled Orders], [Order Attempts] )
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 29001d67-9739-4dfe-ab59-273f7513a292

	/// Full customer base (4,266) incl. guest/unknown-email checkouts (capstone decision 2026-07-22; ecom filtered to 4,263). Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'Distinct Customers' =
			
			DISTINCTCOUNT ( mart_customer_summary[customer_sk] )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 4473184f-f316-4437-a51b-c500a479e92c

	/// Lifetime average 1.12 = 4,757 / 4,266. Lifetime-only: does NOT respond to the date slicer (mart_customer_summary has no dim_date relationship). Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'Orders per Customer' =
			
			DIVIDE ( SUM ( mart_customer_summary[total_orders] ), [Distinct Customers] )
		formatString: #,0.00
		displayFolder: Customers
		lineageTag: 75c0a0dc-9430-45da-857e-ddc8725e59cb

	/// Orders in mart_order_profit (3,813 = completed 3,698 + processing 78 + refunded 37). The shared denominator for every cost/profit ratio.
	measure 'Paid Orders' =
			
			DISTINCTCOUNT ( mart_order_profit[order_sk] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 575908bb-eec9-4dd7-91d5-ad2491796606

	/// Customer shipping charge, all orders ($50,648.98). Counted as REVENUE under Approach A, never a cost; there is no actual_shipping_cost_usd anywhere.
	measure 'Shipping Charged' =
			
			SUM ( fact_order[shipping_charged_usd] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 28113a6b-e499-4efb-a8d2-5b6eef79df77

	/// $70,944.19. Reconciles exactly: [Profit Base Net Revenue] - [Total Cost] = [Contribution Profit].
	measure 'Total Cost' =
			
			[COGS] + [Design Fee] + [Payment Fee]
		formatString: \$#,0
		displayFolder: Cost
		lineageTag: 076d4f19-2aa6-4c85-a1fd-8ec8891567d1

	/// Distinct SKUs with at least one revenue-status line.
	measure 'Distinct Products Sold' =
			
			CALCULATE (
			    DISTINCTCOUNT ( fact_order_item[product_sk] ),
			    fact_order_item[is_revenue_status] = TRUE ()
			)
		formatString: #,0
		displayFolder: Products
		lineageTag: 9306c1b2-2c71-42df-b449-4f6cb246590a

	/// Line-grain contribution profit from mart_product_profit (has dim_product relationship; sums to $86,670.64). Use this - never [Contribution Profit] - on product visuals, which would silently show the grand total on every row.
	measure 'Product Profit' =
			
			SUM ( mart_product_profit[line_profit_usd] )
		formatString: \$#,0
		displayFolder: Products
		lineageTag: 94710e1a-f4db-4662-b3fc-537cc38e6d3a

	/// Line-grain net revenue ($157,614.83 total, matches [Profit Base Net Revenue]). Denominator for [Product Margin]. Per CAPSTONE_BUILD_GUIDE 3.5b.
	measure 'Product Net Revenue' =
			
			SUM ( mart_product_profit[line_net_revenue_usd] )
		formatString: \$#,0
		displayFolder: Products
		lineageTag: 26a53e62-ecba-4160-8116-2bf1bc5d0ddb

	/// Every order row regardless of status (4,757) - the checkout-funnel denominator. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Order Attempts' =
			
			COUNTROWS ( fact_order )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 9cc4332d-76c4-43d4-acbc-089fb1606517

	/// Status = completed (3,698). Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Completed Orders' =
			
			CALCULATE (
			    COUNTROWS ( fact_order ),
			    fact_order[status] = "completed"
			)
		formatString: #,0
		displayFolder: Operations
		lineageTag: 0d000558-2edd-4f91-85f0-4ec1ddf9a22d

	/// Status = failed (437) - payment never settled. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Failed Orders' =
			
			CALCULATE (
			    COUNTROWS ( fact_order ),
			    fact_order[status] = "failed"
			)
		formatString: #,0
		displayFolder: Operations
		lineageTag: fa001892-557b-40c0-9e20-79ca8998d22a

	/// Status = cancelled (499). Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Cancelled Orders' =
			
			CALCULATE (
			    COUNTROWS ( fact_order ),
			    fact_order[status] = "cancelled"
			)
		formatString: #,0
		displayFolder: Operations
		lineageTag: 1ca7eb54-8708-4769-b77f-3b7ddb3be836

	/// Orders still in processing, awaiting fulfilment (90). Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Open Backlog' =
			
			CALCULATE (
			    COUNTROWS ( fact_order ),
			    fact_order[status] = "processing"
			)
		formatString: #,0
		displayFolder: Operations
		lineageTag: 6ae68e38-34e2-4cf5-b963-7c65d4ab4e68

	/// Distinct orders with at least one refund row (34) - robust if an order ever gets multiple refunds. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Refunded Orders' =
			
			DISTINCTCOUNT ( fact_refund[order_sk] )
		formatString: #,0
		displayFolder: Operations
		lineageTag: 12470660-1f93-4e9f-a1f2-c887f101fe5e

	/// Effective processor rate over ALL order value. Deliberately fact_order on both sides - an ops rate per payment method, not a P&L line (P&L fee is [Payment Fee] from the mart). Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Payment Fee Rate' =
			
			DIVIDE (
			    SUM ( fact_order[payment_fee_usd] ),
			    SUM ( fact_order[order_total_usd] )
			)
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 5ec64c69-b49c-4b6c-899b-a4a37505b76c

	/// Customers with more than one lifetime order (384). Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'Repeat Customers' =
			
			CALCULATE (
			    COUNTROWS ( mart_customer_summary ),
			    mart_customer_summary[is_repeat] = TRUE ()
			)
		formatString: #,0
		displayFolder: Customers
		lineageTag: dee130ee-b1eb-4391-a03c-95d8052ff03c

	/// Use with mart_customer_summary[first_order_date] on the axis = new-customer acquisition per period. On a bare card it is simply the total base. Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'New Customers' =
			
			DISTINCTCOUNT ( mart_customer_summary[customer_sk] )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 0dd6047a-3b1b-450b-882f-2f79cceb197f

	/// Pareto numerator: running revenue across products ranked descending. Place on a visual with dim_product[product_name].
	measure 'Cumulative Revenue' =
			
			VAR CurrentRevenue = [Revenue]
			RETURN
			    CALCULATE (
			        [Revenue],
			        FILTER (
			            ALLSELECTED ( dim_product[product_name] ),
			            [Revenue] >= CurrentRevenue
			        )
			    )
		formatString: \$#,0
		displayFolder: Products
		lineageTag: 12d3be24-1ac5-4f28-8013-2b46d28e4d12

	/// 1.13 = 4,309 / 3,813.
	measure 'Avg Units per Order' =
			
			DIVIDE ( [Quantity Sold], [Paid Orders] )
		formatString: #,0.00
		displayFolder: Products
		lineageTag: 1a659016-e389-4368-80d4-f0fc25835ebc

	/// 45.0%. Denominator MUST be [Profit Base Net Revenue]; the product-only base gives the stale pre-Approach-A 60.3%.
	measure 'Cost Ratio' =
			
			DIVIDE ( [Total Cost], [Profit Base Net Revenue] )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: 5aa590ff-bfc6-4958-a76c-21087a5c9057

	/// 38.9% (was 52.1% against the old product-only base).
	measure 'COGS Ratio' =
			
			DIVIDE ( [COGS], [Profit Base Net Revenue] )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: e90f1872-f45c-4bd3-a63e-10b3a3d9e5e4

	/// $18.61 = $70,944.19 / 3,813.
	measure 'Cost per Order' =
			
			DIVIDE ( [Total Cost], [Paid Orders] )
		formatString: \$#,0.00
		displayFolder: Cost
		lineageTag: 1d25a82f-24c8-49f0-af8b-5b61d6adf168

	/// $16.46 = $70,944.19 / 4,309.
	measure 'Cost per Unit' =
			
			DIVIDE ( [Total Cost], [Quantity Sold] )
		formatString: \$#,0.00
		displayFolder: Cost
		lineageTag: 3a499d45-eb4d-47df-a48a-5facc1fd4b56

	/// Line-grain margin, safe to slice by product. Use instead of [Profit Margin] on product visuals.
	measure 'Product Margin' =
			
			DIVIDE ( [Product Profit], [Product Net Revenue] )
		formatString: 0.0%
		displayFolder: Products
		lineageTag: 3be583d3-606b-4744-b20d-23a09854773b

	/// Country share of gross revenue, built on base [Revenue] (now country-aware via fact_order_item.country_sk). Redesign 2026-07-24 — no more [Revenue per Country].
	measure 'Revenue Share' =
			
			DIVIDE (
			    [Revenue],
			    CALCULATE ( [Revenue], ALLSELECTED ( dim_country[country_name] ) )
			)
		formatString: 0.0%
		displayFolder: Markets
		lineageTag: 12f7b199-bab9-4bef-b543-9144ebe8bc8d

	/// Pareto curve: cumulative revenue share by product rank. Top ~11% of SKUs reach 50%.
	measure 'Cumulative Revenue %' =
			
			DIVIDE (
			    [Cumulative Revenue],
			    CALCULATE ( [Revenue], ALLSELECTED ( dim_product[product_name] ) )
			)
		formatString: 0.0%
		displayFolder: Products
		lineageTag: ce1e3d6e-0a5b-43d0-a239-ceb278def160

	/// 80.2% = 3,813 / 4,757. With Failed 9.2% + Cancelled 10.5% the funnel rates are additive. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Paid Success Rate' =
			
			DIVIDE ( [Paid Orders], [Order Attempts] )
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: a1bbd699-ae0f-436d-b56d-49e40715671c

	/// 9.2% = 437 / 4,757 of checkout attempts lost to failed payment. Per CAPSTONE_BUILD_GUIDE 3.8.
	measure 'Failed Rate' =
			
			DIVIDE ( [Failed Orders], [Order Attempts] )
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 39845d8b-da1f-42e6-b9ce-eba5f0c78907

	/// 9.0% = 384 / 4,266. Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'Repeat Rate' =
			
			DIVIDE ( [Repeat Customers], [Distinct Customers] )
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 5cda2e61-6811-4c8b-a9bc-ffbceab64a58

	/// ~67% of the base last ordered 12+ months ago. Depends on the [Recency Segment] calculated column, whose anchor is the dynamic MAX(last_order_date). Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'Lapsed Share' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( mart_customer_summary ),
			        mart_customer_summary[Recency Segment] = "Lapsed 12+mo"
			    ),
			    [Distinct Customers]
			)
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 858e14e1-cd14-4430-bc80-b7c6162867d7

	/// ~91% never reordered - the headline retention weakness on the Customers page. Per CAPSTONE_BUILD_GUIDE 3.7.
	measure 'One-time Share' =
			
			1 - [Repeat Rate]
		formatString: 0.0%
		displayFolder: Customers
		lineageTag: 3d32ee47-b1fc-44d5-8699-403d1eff0bae

	/// Compact card label via UDF MoM_Icon, artifact style: '▲ 5.2% MoM' / '▼ 9.4% MoM' / '-'. Pair with [Revenue MoM Color] on font color fx.
	measure 'Revenue MoM Icon' =
			
			MoM_Icon ( [Revenue] )
		displayFolder: MoM
		lineageTag: 56f150ae-36d6-4614-9016-38ab16a696e4

	/// Hex for conditional font color of [Revenue MoM Icon]: up #2E8B4F, down #E5484D, blank #9AA3AF. Apply via Format > Font color > fx > Field value.
	measure 'Revenue MoM Color' =
			
			MoM_Color ( [Revenue] )
		displayFolder: MoM
		lineageTag: 9948ace6-6103-4fd6-9515-9401ad09dd7a

	/// Card label for profit MoM. Pair with [Profit MoM Color].
	measure 'Profit MoM Icon' =
			
			MoM_Icon ( [Contribution Profit] )
		displayFolder: MoM
		lineageTag: 1d29bbd3-ef81-4765-8cf9-df2fe7d34e1d

	/// Hex for [Profit MoM Icon] font color.
	measure 'Profit MoM Color' =
			
			MoM_Color ( [Contribution Profit] )
		displayFolder: MoM
		lineageTag: e041102f-7610-4989-8a5c-1df8784dfc4e

	/// Card label for orders MoM. Pair with [Orders MoM Color].
	measure 'Orders MoM Icon' =
			
			MoM_Icon ( [Paid Orders] )
		displayFolder: MoM
		lineageTag: 21223076-8660-4db0-9e54-4c89861404ea

	/// Hex for [Orders MoM Icon] font color.
	measure 'Orders MoM Color' =
			
			MoM_Color ( [Paid Orders] )
		displayFolder: MoM
		lineageTag: 016425aa-0e77-4298-924e-e5cefa555be1

	/// Card label for cost MoM. Pair with [Total Cost MoM Color] (inverse palette).
	measure 'Total Cost MoM Icon' =
			
			MoM_Icon ( [Total Cost] )
		displayFolder: MoM
		lineageTag: 81d405c4-c8de-43ac-aff7-efbec1a98aaa

	/// INVERSE hex for [Total Cost MoM Icon]: cost up = red #E5484D, cost down = green #2E8B4F.
	measure 'Total Cost MoM Color' =
			
			Delta_Color_Inverse ( MoM_Perc ( [Total Cost] ) )
		displayFolder: MoM
		lineageTag: 18590212-bc08-4765-a2b8-3047e5fec8f8

	/// Compact card label via UDF YoY_Icon: '▼ 9.4% YoY'. Pair with [Revenue YoY Color] on font color fx.
	measure 'Revenue YoY Icon' =
			
			YoY_Icon ( [Revenue] )
		displayFolder: YoY
		lineageTag: 23ba0f4e-b60e-4d2e-ab4e-aeefd3c1410c

	/// Hex for [Revenue YoY Icon] font color: up #2E8B4F, down #E5484D, blank #9AA3AF.
	measure 'Revenue YoY Color' =
			
			YoY_Color ( [Revenue] )
		displayFolder: YoY
		lineageTag: 2d843c62-3058-4931-9446-2fe3eb380857

	/// Card label for profit YoY. Pair with [Profit YoY Color].
	measure 'Profit YoY Icon' =
			
			YoY_Icon ( [Contribution Profit] )
		displayFolder: YoY
		lineageTag: 0a20a0d2-1d49-4682-8ef4-a19765372ae8

	/// Hex for [Profit YoY Icon] font color.
	measure 'Profit YoY Color' =
			
			YoY_Color ( [Contribution Profit] )
		displayFolder: YoY
		lineageTag: aecd0467-7a08-46c1-8eaa-534facc00b9a

	/// Card label for orders YoY. Pair with [Orders YoY Color].
	measure 'Orders YoY Icon' =
			
			YoY_Icon ( [Paid Orders] )
		displayFolder: YoY
		lineageTag: 20b27fef-2988-4705-8727-181fc3f6411c

	/// Hex for [Orders YoY Icon] font color.
	measure 'Orders YoY Color' =
			
			YoY_Color ( [Paid Orders] )
		displayFolder: YoY
		lineageTag: f8384d48-64a6-456d-809c-29db69109ec3

	/// Card label for cost YoY. Pair with [Total Cost YoY Color] (inverse palette).
	measure 'Total Cost YoY Icon' =
			
			YoY_Icon ( [Total Cost] )
		displayFolder: YoY
		lineageTag: dcfc834d-79ea-48d5-9a05-7428ad9449da

	/// INVERSE hex for [Total Cost YoY Icon]: cost up = red #E5484D, cost down = green #2E8B4F.
	measure 'Total Cost YoY Color' =
			
			Delta_Color_Inverse ( YoY_Perc ( [Total Cost] ) )
		displayFolder: YoY
		lineageTag: 61aea43a-8c39-48cd-986e-4df07c524337

	/// Compact card label via UDF PoP_Icon: selected period vs previous equal-length period, artifact style '▲ 5.2% PoP'. FOLLOWS the date slicer (needs one — no slicer shows '–'). Pair with [Revenue PoP Color].
	measure 'Revenue PoP Icon' = PoP_Icon ( [Revenue] )
		displayFolder: PoP
		lineageTag: d17ad960-648c-4ea7-bb7e-3be6123327a3

	/// Hex for conditional font color of [Revenue PoP Icon]: up #2E8B4F, down #E5484D, blank #9AA3AF. Apply via Format > Font color > fx > Field value.
	measure 'Revenue PoP Color' = Delta_Color ( PoP_Perc ( [Revenue] ) )
		displayFolder: PoP
		lineageTag: 14efd8c9-81f5-4e44-a8bf-a87c6bf89e40

	/// Card label for profit PoP (selected vs previous equal period). Needs date slicer. Pair with [Profit PoP Color].
	measure 'Profit PoP Icon' = PoP_Icon ( [Contribution Profit] )
		displayFolder: PoP
		lineageTag: c9278bd6-2da6-4a0a-8c08-62e622a2aba1

	/// Hex for [Profit PoP Icon] font color.
	measure 'Profit PoP Color' = Delta_Color ( PoP_Perc ( [Contribution Profit] ) )
		displayFolder: PoP
		lineageTag: 9e6eaa68-f15d-4e18-84f1-168edeee4615

	/// Card label for orders PoP (selected vs previous equal period). Needs date slicer. Pair with [Orders PoP Color].
	measure 'Orders PoP Icon' = PoP_Icon ( [Paid Orders] )
		displayFolder: PoP
		lineageTag: 14207476-7410-4964-8b41-31cb17953d30

	/// Hex for [Orders PoP Icon] font color.
	measure 'Orders PoP Color' = Delta_Color ( PoP_Perc ( [Paid Orders] ) )
		displayFolder: PoP
		lineageTag: 502af77b-e331-416a-a82e-c99e687c097c

	/// Card label for cost PoP (selected vs previous equal period). Needs date slicer. Pair with [Total Cost PoP Color] (inverse palette).
	measure 'Total Cost PoP Icon' = PoP_Icon ( [Total Cost] )
		displayFolder: PoP
		lineageTag: c53cf8be-fff8-4fef-a70a-e99ee634889c

	/// INVERSE hex for [Total Cost PoP Icon]: cost up = red #E5484D, cost down = green #2E8B4F.
	measure 'Total Cost PoP Color' = Delta_Color_Inverse ( PoP_Perc ( [Total Cost] ) )
		displayFolder: PoP
		lineageTag: 1f7f22dc-f574-41c6-9a07-b6719157395e

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

