table _Measures
	lineageTag: a0426c5b-05c6-4ed5-a7a1-402d3e13566e

	/// Gross revenue (before refunds). Sum of line_revenue_usd on revenue-status order items only. Revenue lives once at the item grain — never read from fact_order (no revenue column there, deliberate anti-double-count).
	measure Revenue =
			
			CALCULATE(
			    SUM(fact_order_item[line_revenue_usd]),
			    fact_order_item[is_revenue_status] = TRUE()
			)
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: a63dfddc-2b76-4495-8332-4b39cca9208c

		annotation PBI_FormatHint = {"isCustom":true}

	/// Gross Revenue (§A1) minus refunds. [Refund Amount] is defined in group C (Refunds). This is the profit-margin denominator; for exact tie-out to the mart use SUM(mart_order_profit[net_revenue_usd]).
	measure 'Net Revenue' =
			
			[Revenue] - [Refund Amount]
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: f78e1109-534b-46ef-91ce-dc6f4a033f76

		annotation PBI_FormatHint = {"isCustom":true}

	/// Distinct count of revenue-status orders (processing, completed, on-hold). Denominator for AOV.
	measure Orders =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order[order_sk]),
			    fact_order[status] IN { "processing", "completed", "on-hold" }
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: 7655d605-2c5f-4fe1-8e78-b2048b219e78

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total units sold across order items. Denominator for AIV.
	measure 'Quantity Sold' =
			
			CALCULATE(
			    SUM(fact_order_item[quantity]),
			    fact_order_item[is_revenue_status] = TRUE()
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: 019218d0-7005-4b1a-828a-95102652254b

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average Order Value = gross Revenue (§A1) / Orders (§A3). Safe divide returns blank on zero orders.
	measure AOV =
			
			DIVIDE([Revenue], [Orders])
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: 6fc7f1cc-291d-4265-b8cd-c7ed9291070a

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average Item Value = gross Revenue (§A1) / Quantity Sold (§A4).
	measure AIV =
			
			DIVIDE([Revenue], [Quantity Sold])
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: 042e3f58-11b3-4357-8c8f-52d070649d1b

		annotation PBI_FormatHint = {"isCustom":true}

	/// Revenue-side shipping — what the customer paid at checkout (Woo). This is NOT a cost and must never enter a profit or COGS formula; there is no actual_shipping_cost_usd field.
	measure 'Shipping Charged to Customer' =
			
			SUM(fact_order[shipping_charged_usd])
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: a4d56771-8450-49f5-838b-87aaa69e51f1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Shipping charged to customer (§A7) / gross Revenue (§A1). Labeled 'shipping charged to customer / revenue' — NOT shipping cost.
	measure 'Shipping Charged % of Revenue' =
			
			DIVIDE([Shipping Charged to Customer], [Revenue])
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: b5046cc1-6508-445b-87d0-7624091b7723

		annotation PBI_FormatHint = {"isCustom":true}

	/// Count of orders still in 'processing' status (awaiting fulfillment) — operational backlog available in Phase 4.
	measure 'Open Order Backlog' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_order[order_sk]),
			    fact_order[status] = "processing"
			)
		formatString: #,0
		displayFolder: Sales
		lineageTag: ba58bcdb-245b-4801-b3f9-0dd88269a12f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Month-over-month change in gross Revenue (§A1) vs the prior month via DATEADD on dim_date. Exec card delta. Requires a contiguous dim_date marked as the date table.
	measure 'Revenue MoM %' = ```
			
			VAR CurrentPeriod = [Revenue]
			VAR PriorPeriod =
			    CALCULATE(
			        [Revenue],
			        DATEADD(dim_date[date_day], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentPeriod - PriorPeriod, PriorPeriod)
			
			```
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: a2e902e1-1905-4ad2-b427-d693b7563d20

		annotation PBI_FormatHint = {"isCustom":true}

	/// Month-over-month change in Net Revenue (§A2, gross minus refunds) vs the prior month via DATEADD on dim_date. Exec card delta.
	measure 'Net Revenue MoM %' =
			
			VAR CurrentPeriod = [Net Revenue]
			VAR PriorPeriod =
			    CALCULATE(
			        [Net Revenue],
			        DATEADD(dim_date[date_day], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentPeriod - PriorPeriod, PriorPeriod)
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: c3640f25-f3cc-4c16-a208-bc50fa71cb8b

		annotation PBI_FormatHint = {"isCustom":true}

	/// Month-over-month change in Shipping Charged to Customer (§A7, revenue-side) vs the prior month via DATEADD on dim_date.
	measure 'Shipping Charged MoM %' =
			
			VAR CurrentPeriod = [Shipping Charged to Customer]
			VAR PriorPeriod =
			    CALCULATE(
			        [Shipping Charged to Customer],
			        DATEADD(dim_date[date_day], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentPeriod - PriorPeriod, PriorPeriod)
		formatString: " 0.0%"
		displayFolder: Sales
		lineageTag: 43ec4238-82de-40f5-8c7b-31a9a35cef90

		annotation PBI_FormatHint = {"isCustom":true}

	/// Month-over-month change in Contribution Profit vs the prior month via DATEADD on dim_date.
	measure 'Contribution Profit MoM %' =
			
			VAR CurrentPeriod = [Contribution Profit]
			VAR PriorPeriod =
			    CALCULATE(
			        [Contribution Profit],
			        DATEADD(dim_date[date_day], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentPeriod - PriorPeriod, PriorPeriod)
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: fb5e15c4-4ba0-45f7-8d7e-24bd826ff3d7

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total cost of goods sold in USD, summed from the order-profit mart (marts_core.mart_order_profit). Per METRICS_DEFINITION §B1, cogs_usd ALREADY includes the supplier fulfillment/shipping fee — do NOT add any shipping term on top of this.
	measure COGS =
			
			SUM ( mart_order_profit[cogs_usd] )
		formatString: \$#,0.00
		displayFolder: Profitability
		lineageTag: 618bb69c-8fa7-4f33-a07f-9437fe6745e2

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total payment-processor fees in USD at the order grain (marts_core.fact_order[payment_fee_usd]). Coverage/exactness of this figure is surfaced separately via [Payment Fee Coverage %] and [Payment Fee Chip].
	measure 'Payment Fee' =
			
			SUM ( fact_order[payment_fee_usd] )
		formatString: \$#,0.00
		displayFolder: Profitability
		lineageTag: 2fd41c7e-31d6-4ea6-8eb5-49513bad508e

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total design fee in USD summed from marts_core.mart_order_profit[design_fee_usd]. One of the three cost components subtracted from net revenue to reach contribution profit.
	measure 'Design Fee' =
			
			SUM ( mart_order_profit[design_fee_usd] )
		formatString: \$#,0.00
		displayFolder: Profitability
		lineageTag: 0018495b-f1d8-4879-a397-333140e1f52c

		annotation PBI_FormatHint = {"isCustom":true}

	/// Gross profit = gross Revenue (A1) minus COGS (B1). This deliberately does NOT subtract design fee or payment fee (that is Contribution Profit, B5) and never subtracts shipping.
	measure 'Gross Profit' =
			
			[Revenue] - [COGS]
		formatString: " \$#,0.00"
		displayFolder: Profitability
		lineageTag: a68e5ad2-e028-43db-9eb6-5329a7d32301

		annotation PBI_FormatHint = {"isCustom":true}

	/// Exact net-revenue denominator used for profit margin: gross Revenue minus refunds, read directly from the pre-computed marts_core.mart_order_profit[net_revenue_usd] so it reconciles to the mart (117,911.47 for FOS). Prefer this over recomputing Revenue − Refunds in DAX. Underpins §B6. See docs/METRICS_DEFINITION.md §B6.
	measure 'Profit Base Net Revenue' =
			
			SUM ( mart_order_profit[net_revenue_usd] )
		formatString: \$#,0.00
		displayFolder: Profitability
		lineageTag: 89b694bc-1f7f-4ea3-bffa-42939672f91a

		annotation PBI_FormatHint = {"isCustom":true}

	/// Contribution profit in USD, summed from the pre-computed marts_core.mart_order_profit[contribution_profit_usd] (47,535.65 for FOS). Locked formula = net_revenue − cogs − design_fee − payment_fee, with NO shipping term because supplier shipping is already inside cogs_usd.
	measure 'Contribution Profit' =
			
			SUM ( mart_order_profit[contribution_profit_usd] )
		formatString: \$#,0.00
		displayFolder: Profitability
		lineageTag: f81bff96-5ac4-487b-9db8-cfd0c12bf2b5

		annotation PBI_FormatHint = {"isCustom":true}

	/// Contribution profit margin = Contribution Profit (B5) ÷ Net Revenue (Profit Base Net Revenue), safe-divided. Denominator is net revenue per invariant #4 (40.19% for FOS). See docs/METRICS_DEFINITION.md §B6.
	measure 'Profit Margin' =
			
			DIVIDE ( [Contribution Profit], [Profit Base Net Revenue] )
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: a51c2fe3-094d-4efe-876c-4a8e9552a094

		annotation PBI_FormatHint = {"isCustom":true}

	/// Return on cost of goods = Contribution Profit (B5) ÷ COGS (B1), safe-divided. Expresses profit generated per dollar of product cost. See docs/METRICS_DEFINITION.md §B7.
	measure ROI =
			
			DIVIDE ( [Contribution Profit], [COGS] )
		formatString: 0.0%
		displayFolder: Profitability
		lineageTag: cf41c33d-100a-41a9-84b5-3c2af02499d0

		annotation PBI_FormatHint = {"isCustom":true}

	/// All-sites cost coverage percentage, read from the reconciliation view marts_recon.recon_cost_coverage on the '__ALL__' roll-up row. Stored on a 0–100 scale (e.g. 98.79). Drives every tier-gating measure in §J/§K. See docs/METRICS_DEFINITION.md §J.
	measure 'Cost Coverage %' = ```
			
			CALCULATE (
			    MAX ( recon_cost_coverage[cost_coverage_pct] ),
			    recon_cost_coverage[site_sk] = "__ALL__"
			)
			
			```
		formatString: 0.00\%
		displayFolder: Profitability
		lineageTag: fc1ec8e2-af91-476a-bcaf-6aa6bc987be0

		annotation PBI_FormatHint = {"isCustom":true}

	/// Payment-fee coverage percentage (revenue-order basis, same as H1) from marts_recon.recon_payment_fee_coverage on the '__ALL__' roll-up row, stored on a 0–100 scale (e.g. 98.03). When below 80 it activates [Payment Fee Chip] per invariant #6. See docs/METRICS_DEFINITION.md §H4/§K + METRIC_CHANGES.md.
	measure 'Payment Fee Coverage %' =
			
			CALCULATE (
			    MAX ( recon_payment_fee_coverage[fee_coverage_pct] ),
			    recon_payment_fee_coverage[payment_fee_source] = "__ALL__"
			)
		formatString: 0.00\%
		displayFolder: Profitability
		lineageTag: eb767b9b-773a-4a7b-9416-af02139f0c73

		annotation PBI_FormatHint = {"isCustom":true}

	/// Data-quality tier driving dashboard gating: green (≥95%, fully trusted, no chip), yellow (80–95%, partial-coverage chip), red (<80%, profit visuals hidden + 'Profit unavailable' banner). Thresholds per invariant #5. See docs/METRICS_DEFINITION.md §J.
	measure 'Coverage Tier' =
			
			SWITCH (
			    TRUE (),
			    [Cost Coverage %] >= 95, "green",
			    [Cost Coverage %] >= 80, "yellow",
			    "red"
			)
		displayFolder: Profitability
		lineageTag: 2db2c367-daf5-40f5-9b5d-ae340922de63

	/// Returns 1 when cost coverage ≥80% (profit is trustworthy enough to show), else 0. Apply as a visual-level filter (keep rows where flag = 1) to hide profit visuals when coverage is in the red tier, per invariant #5 / §J. See docs/METRICS_DEFINITION.md §J.
	measure 'Profit Visible Flag' =
			
			IF ( [Cost Coverage %] >= 80, 1, 0 )
		formatString: #,0
		displayFolder: Profitability
		lineageTag: d59556f5-1f4e-445a-8a46-77f7e51b0be1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Red-tier banner text shown only when cost coverage <80%; BLANK otherwise so the banner card collapses. Pairs with [Profit Visible Flag] = 0 to explain why profit visuals are hidden (§J, invariant #5). See docs/METRICS_DEFINITION.md §J.
	measure 'Profit Unavailable Banner' =
			
			IF (
			    [Cost Coverage %] < 80,
			    "Profit unavailable — cost coverage too low",
			    BLANK ()
			)
		displayFolder: Profitability
		lineageTag: 82fde36c-3371-44cd-bca2-af7e495769db

	/// Yellow-tier chip text shown only when cost coverage is in the 80–95% band; BLANK otherwise. Divides the 0–100 coverage value by 100 before the 0.0% format so it renders correctly (e.g. '(90.0%)'). Per invariant #5 / §J. See docs/METRICS_DEFINITION.md §J.
	measure 'Partial Coverage Chip' =
			
			IF (
			    AND ( [Cost Coverage %] >= 80, [Cost Coverage %] < 95 ),
			    "Partial cost coverage ("
			        & FORMAT ( [Cost Coverage %] / 100, "0.0%" )
			        & ") — usable but not owner-trusted",
			    BLANK ()
			)
		displayFolder: Profitability
		lineageTag: 169195c8-0766-4141-a90b-287fa7b1b7f2

	/// Second chip shown on every profit visual when payment-fee coverage <80% (98.03% revenue-order basis for FOS → chip OFF). Reports the estimated share (100 − coverage) sourced from seed_estimate/missing. Per invariant #6 / §K. See docs/METRICS_DEFINITION.md §K.
	measure 'Payment Fee Chip' = ```
			
			IF (
			    [Payment Fee Coverage %] < 80,
			    "Estimated payment fee — "
			        & FORMAT ( ( 100 - [Payment Fee Coverage %] ) / 100, "0.0%" )
			        & " from seed_estimate or missing",
			    BLANK ()
			)
			
			```
		displayFolder: Profitability
		lineageTag: 8696a0cb-9fe5-4989-a8dc-38ba61aff21e

	/// Static explanatory caveat displayed alongside profit visuals, encoding invariants #2/#4/#6: supplier shipping is already inside COGS (no double subtraction) and the CSV Shipping column is a customer charge, not a cost. See docs/METRICS_DEFINITION.md §B5.
	measure 'Profit Caveat Banner' =
			
			"COGS includes supplier fulfillment/shipping fee based on the manual sheet, so contribution profit does not subtract shipping again. The CSV Shipping column is the customer shipping charge, not a cost."
		displayFolder: Profitability
		lineageTag: e0090f96-f892-4d71-835d-f5bd78a2641d

	/// Product-page chip shown when any product rows in the current filter context have a cost_allocation_method other than 'line_exact' (i.e. cost was spread by revenue share rather than measured per line) in marts_core.mart_product_profit; BLANK when every selected row is line-exact. See docs/METRICS_DEFINITION.md §B8.
	measure 'Product Profit Allocation Chip' = ```
			
			VAR NonExactRows =
			    CALCULATE (
			        COUNTROWS ( mart_product_profit ),
			        mart_product_profit[cost_allocation_method] <> "line_exact"
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( NonExactRows ) && NonExactRows > 0,
			        "Profit allocated by revenue share — not exact line-level cost",
			        BLANK ()
			    )
			
			```
		displayFolder: Profitability
		lineageTag: f2703786-d3f8-43d7-b27a-54c576797715

	/// Count of refund rows in fact_refund (one row per Woo refund event). See docs/METRICS_DEFINITION.md §C1. Expected whole-dataset value: 34.
	measure 'Refunded Order Count' =
			
			COUNTROWS ( fact_refund )
		formatString: #,0
		displayFolder: Refund / Cancellation
		lineageTag: a7d27eac-132d-4139-bf15-8c34b6480ded

		annotation PBI_FormatHint = {"isCustom":true}

	/// Total refunded value in USD from fact_refund. See docs/METRICS_DEFINITION.md §C2.
	measure 'Refund Amount' =
			
			SUM ( fact_refund[refund_amount_usd] )
		formatString: \$#,0.00
		displayFolder: Refund / Cancellation
		lineageTag: 9c190032-fbcd-4f34-9bc2-3722787bbacd

		annotation PBI_FormatHint = {"isCustom":true}

	/// Distinct orders that reached a settleable state (excludes 'failed' and 'pending'); the denominator for refund/cancellation rates. See docs/METRICS_DEFINITION.md §C3.
	measure 'Eligible Orders' = ```
			
			CALCULATE (
			    DISTINCTCOUNT ( fact_order[order_sk] ),
			    NOT ( fact_order[status] IN { "failed", "pending" } )
			)
			
			```
		formatString: #,0
		displayFolder: Refund / Cancellation
		lineageTag: 4a8d27b5-c7b3-4706-be61-19e6844f6545

		annotation PBI_FormatHint = {"isCustom":true}

	/// Distinct orders that either have at least one refund row (fact_refund) OR carry status = 'cancelled' in fact_order, de-duplicated so an order counted once even if both. TREATAS remaps fact_refund[order_sk] onto fact_order[order_sk] so UNION/DISTINCT share lineage. Numerator of Refund Rate. See docs/METRICS_DEFINITION.md §C3.
	measure 'Refunded or Cancelled Orders' =
			
			VAR CancelledKeys =
			    CALCULATETABLE (
			        VALUES ( fact_order[order_sk] ),
			        fact_order[status] = "cancelled"
			    )
			VAR RefundedKeys =
			    TREATAS (
			        VALUES ( fact_refund[order_sk] ),
			        fact_order[order_sk]
			    )
			VAR CombinedKeys =
			    DISTINCT ( UNION ( CancelledKeys, RefundedKeys ) )
			RETURN
			    COUNTROWS ( CombinedKeys )
		formatString: #,0
		displayFolder: Refund / Cancellation
		lineageTag: f0d252b8-c39a-44b7-aeec-d2ee25a65a5b

		annotation PBI_FormatHint = {"isCustom":true}

	/// Order-level refund/cancellation rate = Refunded or Cancelled Orders / Eligible Orders. Order grain (not line or amount). See docs/METRICS_DEFINITION.md §C3.
	measure 'Refund Rate' =
			
			DIVIDE (
			    [Refunded or Cancelled Orders],
			    [Eligible Orders]
			)
		formatString: 0.0%
		displayFolder: Refund / Cancellation
		lineageTag: e71c0299-e5be-4991-9015-3f5dc01f5cd3

		annotation PBI_FormatHint = {"isCustom":true}

	/// Share of eligible orders with status = 'cancelled' = distinct cancelled orders / Eligible Orders. See docs/METRICS_DEFINITION.md §C4.
	measure 'Cancellation Rate' =
			
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( fact_order[order_sk] ),
			        fact_order[status] = "cancelled"
			    ),
			    [Eligible Orders]
			)
		formatString: 0.0%
		displayFolder: Refund / Cancellation
		lineageTag: 14c90891-e567-4404-bca3-92eedd5c3533

		annotation PBI_FormatHint = {"isCustom":true}

	/// Refunded dollars as a share of gross Revenue = Refund Amount / Revenue. [Revenue] is the group-A gross revenue measure (SUM fact_order_item[line_revenue_usd] filtered to is_revenue_status = TRUE()). See docs/METRICS_DEFINITION.md §C5.
	measure 'Refund Revenue Share' =
			
			DIVIDE (
			    [Refund Amount],
			    [Revenue]
			)
		formatString: 0.0%
		displayFolder: Refund / Cancellation
		lineageTag: 2cd4553c-3108-4877-ab02-dfde7874054f

		annotation PBI_FormatHint = {"isCustom":true}

	/// Per-country gross revenue grouped correctly by country while preserving invariant #1 (revenue from fact_order_item). See docs/METRICS_DEFINITION.md §G2.
	measure 'Revenue per Country' =
			
			CALCULATE (
			    [Revenue],
			    TREATAS ( VALUES ( fact_order[order_sk] ), fact_order_item[order_sk] )
			)
			-- Transfers the country-filtered fact_order rows to fact_order_item via order_sk,
			-- so per-country revenue still sums fact_order_item[line_revenue_usd] (is_revenue_status = TRUE inside [Revenue]).
			-- Alternative: enable a country_sk bridge / bidirectional cross-filter dim_country -> fact_order -> fact_order_item.
			-- Do NOT read revenue from fact_order (no revenue column) and do NOT substitute mart_country_profit[revenue_usd] (that is NET revenue, not gross A1).
		formatString: \$#,0.00
		displayFolder: Site & Geography
		lineageTag: 8649f52a-fedf-4744-8524-3763e9c1cf9d

		annotation PBI_FormatHint = {"isCustom":true}

	/// AOV per country/site with a sample-size guard: returns the average order value only when at least 10 orders are present in the current filter context, otherwise BLANK() so thin slices are hidden from the visual. Reuses [AOV] and [Orders]. See docs/METRICS_DEFINITION.md §G3.
	measure 'AOV (min 10 orders)' =
			
			VAR OrderCount = [Orders]
			RETURN
			    IF (
			        OrderCount >= 10,
			        [AOV],
			        BLANK ()
			    )
		formatString: \$#,0.00
		displayFolder: Site & Geography
		lineageTag: 4f3cbf05-4def-4f3e-904f-c5ff5b192c35

		annotation PBI_FormatHint = {"isCustom":true}

	/// as a plain §A8 reuse, the numerator SUM(fact_order[shipping_charged_usd]) filters by country but the denominator [Revenue] (fact_order_item, no country_sk) does not, giving country-shipping / TOTAL-revenue. To fix per-country, use a dedicated measure that filters both sides to the same country orders
	measure 'Shipping Charged Ratio by Country' =
			
			VAR ShipByCountry = SUM ( fact_order[shipping_charged_usd] )
			VAR RevByCountry = CALCULATE ( [Revenue], TREATAS ( VALUES ( fact_order[order_sk] ), fact_order_item[order_sk] ) )
			RETURN DIVIDE ( ShipByCountry, RevByCountry )
		formatString: 0.0%
		displayFolder: Site & Geography
		lineageTag: fcf52f4f-4111-41df-9139-dcf38fca055a

		annotation PBI_FormatHint = {"isCustom":true}

	/// By-country (or by-site) order-level refund rate with a sample-size guard: returns [Refund Rate] only when at least 10 eligible orders exist in context, otherwise BLANK() to suppress noisy low-volume slices. Reuses [Refund Rate] (§C3) and [Eligible Orders]. See docs/METRICS_DEFINITION.md §G4 / §C3.
	measure 'Refund Rate (min 10 orders)' = ```
			
			VAR EligibleOrderCount = [Eligible Orders]
			RETURN
			    IF (
			        EligibleOrderCount >= 10,
			        [Refund Rate],
			        BLANK ()
			    )
			
			```
		formatString: 0.0%
		displayFolder: Site & Geography
		lineageTag: 9f1ea783-6df2-452b-89fe-332f31159bfb

		annotation PBI_FormatHint = {"isCustom":true}

	/// share of orders with a non-null cogs_usd, read straight from the dbt-computed recon '__ALL__' row (cogs_coverage_pct, e.g. 98.79) so the value matches dbt exactly rather than being recomputed in DAX. Target ≥ 80%. Value is pre-scaled 0–100, so the literal-percent format (0.0"%") avoids a ×100. See docs/METRICS_DEFINITION.md §H3.
	measure 'COGS Coverage %' =
			
			CALCULATE (
			    MAX ( recon_cost_coverage[cogs_coverage_pct] ),
			    recon_cost_coverage[site_sk] = "__ALL__"
			)
		formatString: 0.0"%"
		displayFolder: Data Quality & Coverage
		lineageTag: b75f5633-a011-4cd1-b375-3dbf7cfe696e

		annotation PBI_FormatHint = {"isCustom":true}

	/// share of product-profit line items whose cost was allocated by exact line match (cost_allocation_method = 'line_exact') rather than an order-level split. A quality signal for cost granularity, not a gate. Computed live from mart_product_profit → 0–1 fraction, so standard 0.0% (×100) is correct here. See docs/METRICS_DEFINITION.md §H2.
	measure 'Cost Allocation Coverage %' =
			
			VAR LineExactRows =
			    CALCULATE (
			        COUNTROWS ( mart_product_profit ),
			        mart_product_profit[cost_allocation_method] = "line_exact"
			    )
			VAR TotalRows =
			    COUNTROWS ( mart_product_profit )
			RETURN
			    DIVIDE ( LineExactRows, TotalRows )
		formatString: 0.0%
		displayFolder: Data Quality & Coverage
		lineageTag: eb79a65e-fdba-4b33-8cce-fc4fd913569f

		annotation PBI_FormatHint = {"isCustom":true}

	/// the current payment_fee_source's share of all orders across the real source rows (excludes the '__ALL__' aggregate). Feeds the Payment Fee Source Mix visual when a normalized 0–100% proportion is wanted instead of raw counts. See docs/METRICS_DEFINITION.md §H4b.
	measure 'Payment Fee Source Share' =
			
			VAR SourceOrders =
			    CALCULATE (
			        SUM ( recon_payment_fee_coverage[order_count] ),
			        KEEPFILTERS ( recon_payment_fee_coverage[payment_fee_source] <> "__ALL__" )
			    )
			VAR TotalSourceOrders =
			    CALCULATE (
			        SUM ( recon_payment_fee_coverage[order_count] ),
			        REMOVEFILTERS ( recon_payment_fee_coverage[payment_fee_source] ),
			        recon_payment_fee_coverage[payment_fee_source] <> "__ALL__"
			    )
			RETURN
			    DIVIDE ( SourceOrders, TotalSourceOrders )
		formatString: 0.0%
		displayFolder: Data Quality & Coverage
		lineageTag: c8a6ff5c-fb83-464c-98c2-4d373c7212b8

		annotation PBI_FormatHint = {"isCustom":true}

	/// the average per-row percentage delta between Woo's shipping_charged_usd and the CSV Shipping column, for an at-a-glance reconciliation health number above the detail table. Report only — both sides are revenue-side shipping charged to the customer, not cost. delta_pct is pre-scaled (e.g. -1.23 = -1.23%), so the literal-percent format avoids ×100. See docs/METRICS_DEFINITION.md §H10.
	measure 'Woo vs CSV Shipping Drift %' =
			
			AVERAGE ( recon_woo_vs_csv_shipping_charged[delta_pct] )
		formatString: 0.0"%"
		displayFolder: Data Quality & Coverage
		lineageTag: c860f251-2327-4298-86b1-580651a6cefb

		annotation PBI_FormatHint = {"isCustom":true}

	/// Count of unique known customers (hashed email) with a resolvable identity. Restricts to dim_customer_anonymized[is_unknown_email] = FALSE() via the customer relationship so guest/unknown-email checkouts are excluded from the customer base. See docs/METRICS_DEFINITION.md §I1.
	measure 'Distinct Customers' =
			
			CALCULATE (
			    DISTINCTCOUNT ( mart_customer_summary[customer_hash] ),
			    dim_customer_anonymized[is_unknown_email] = FALSE ()
			)
		formatString: #,0
		displayFolder: Customer
		lineageTag: 89f6f4c6-b7b8-44a3-8f63-3f0c23dba649

		annotation PBI_FormatHint = {"isCustom":true}

	/// Share of the customer base that has ordered more than once: repeat customers (mart_customer_summary[is_repeat] = TRUE()) divided by all customers. Safe-divided so an empty base returns blank. See docs/METRICS_DEFINITION.md §I2.
	measure 'Repeat Customer Share' = ```
			
			VAR RepeatCustomers =
			    CALCULATE (
			        COUNTROWS ( mart_customer_summary ),
			        mart_customer_summary[is_repeat] = TRUE ()
			    )
			VAR AllCustomers =
			    COUNTROWS ( mart_customer_summary )
			RETURN
			    DIVIDE ( RepeatCustomers, AllCustomers )
			
			```
		formatString: 0.0%
		displayFolder: Customer
		lineageTag: 59e9fde8-e36a-4775-b3f7-209800631a11

		annotation PBI_FormatHint = {"isCustom":true}

	/// Average number of orders per known customer: [Orders] divided by [Distinct Customers]. Reuses the canonical order and customer measures so filter context stays consistent across visuals. See docs/METRICS_DEFINITION.md §I3.
	measure 'Orders per Customer' =
			
			DIVIDE ( [Orders], [Distinct Customers] )
		formatString: 0.00
		displayFolder: Customer
		lineageTag: 484383c8-c148-4e79-8435-88d6230fd0b1

		annotation PBI_FormatHint = {"isCustom":true}

	/// Share of lifetime customer revenue generated by repeat customers: summed total_revenue_usd for is_repeat = TRUE() divided by total customer revenue. Uses mart_customer_summary lifetime revenue (customer-grain), not the item-grain gross Revenue measure. See docs/METRICS_DEFINITION.md §I4.
	measure 'Repeat Revenue Share' =
			
			VAR RepeatRevenue =
			    CALCULATE (
			        SUM ( mart_customer_summary[total_revenue_usd] ),
			        mart_customer_summary[is_repeat] = TRUE ()
			    )
			VAR TotalCustomerRevenue =
			    SUM ( mart_customer_summary[total_revenue_usd] )
			RETURN
			    DIVIDE ( RepeatRevenue, TotalCustomerRevenue )
		formatString: 0.0%
		displayFolder: Customer
		lineageTag: a1cffe40-e6bc-4052-9773-b253853a87ec

		annotation PBI_FormatHint = {"isCustom":true}

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

