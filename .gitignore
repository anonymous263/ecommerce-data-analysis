# Environment and secrets
.env
.env.*
!.env.example

# Private source data
data/raw/
Order Management.csv
POD Management - Order*.csv

# Service account / credential files.
# Keep package/config JSON trackable; ignore credential-shaped JSON only.
*service-account*.json
*credentials*.json
google-application-credentials*.json
gcp-*.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Jupyter
.ipynb_checkpoints/

# Power BI
# .pbix is a BINARY that EMBEDS the imported data (Import mode) — a full extract of
# marts incl. hashed emails and order values. Same rule as db/dumps: never committed.
# Source of truth is the .pbip project (TMDL text), which is tracked.
*.pbix
*.pbix.backup

# .pbip local artifacts: cache.abf holds the imported DATA; localSettings.json holds
# per-machine paths/credentials. The TMDL under *.SemanticModel/ and *.Report/ IS tracked.
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/*.Dataset/.pbi/
**/*.SemanticModel/.pbi/cache.abf

# Database dumps — 600MB+ and contain REAL PII in raw payloads.
# NOT for a normal git push (see db/README.md). Un-ignore only if you
# deliberately choose Git LFS, and scrub before making the repo public.
db/dumps/
*.dump
*.sql.gz

# OS/editor noise
.DS_Store
Thumbs.db

# Large local/sample datasets
E-commerce data sample/*.csv
E-commerce data sample/*.docx
# OMC operational state (keep project skills only)
.omc/
!.omc/skills/
